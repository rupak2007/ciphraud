# Python
__pycache__/
*.py[cod]
.venv/
.venv-wsl/
venv/
env/
.pytest_cache/

# Secrets
.env
.env.*
!.env.example

# Data
# Anchored to repo root (leading /) -- an unanchored "data/" also matches
# src/data/ (the actual pipeline module), which would silently untrack it.
/data/
/datasets/
*.csv
*.parquet
*.zip
*.7z

# Generated experiment/EDA result tables are committed deliberately: they are
# small aggregates and every reported number must trace to one (CLAUDE.md §9).
# This negation is required because the blanket *.csv above would otherwise
# swallow them silently. Raw data under data/ stays ignored regardless.
!results/**/*.csv

# ML artifacts
models/
checkpoints/
*.pt
*.pth
*.onnx
*.safetensors

# Generated/build files
build/
dist/
outputs/
*.log
# Phase 10 archived as-run evidence: the raw server logs are hashed by the archives' SHA256SUMS.json and cited by the recorded corrections
!results/phase10_client_server/**/raw_logs/*.log

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Concrete-ML compile diagnostics dump
.artifacts/

# Claude Code local session state
.claude/
